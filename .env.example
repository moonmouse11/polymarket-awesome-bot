# MongoDB users. Created only on the first start with an empty volume.
# Use URL-safe passwords (they go into connection strings), e.g.: openssl rand -hex 24
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_me_root
MONGO_APP_USER=polymarket_app
MONGO_APP_PASSWORD=change_me_app
MONGO_TEST_USER=polymarket_test
MONGO_TEST_PASSWORD=change_me_test

# Used only by `go run ./cmd/bot` on the host. In Docker, compose builds MONGO_URI itself.
MONGO_URI=mongodb://polymarket_app:change_me_app@localhost:27017/polymarket?authSource=polymarket
# Used by `go test ./internal/db/`; tests are skipped if empty.
MONGO_TEST_URI=mongodb://polymarket_test:change_me_test@localhost:27017/polymarket_test?authSource=polymarket_test

# Health check server port (go run on the host; compose fixes it to 8080).
PORT=8080

JEV_API_KEY=your_jev_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

LOG_LEVEL=info
LOG_FORMAT=console
